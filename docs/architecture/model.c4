// Current and planned architecture for dotnet-observability-lab.
// Elements tagged as #future are intentional placeholders required by the roadmap
// and must not be read as already implemented runtime dependencies.

specification {
  tag api
  tag worker
  tag database
  tag cache
  tag broker
  tag orchestration
  tag external
  tag future

  element actor {
    style {
      shape person
    }
  }

  element softwareSystem
  element container
  element component
}

model {
  apiClient = actor "API client" {
    #external
    description "Calls the write and read HTTP APIs to exercise the lab scenarios."
  }

  developer = actor "Developer" {
    #external
    description "Runs the local environment, changes the implementation, and inspects architecture and telemetry."
  }

  lab = softwareSystem "dotnet-observability-lab" {
    description "Reference implementation for reliable asynchronous processing and distributed observability with .NET Aspire and OpenTelemetry."

    ingestionApi = container "Ingestion.Api" {
      #api
      technology ".NET 10 / ASP.NET Core Minimal API"
      description "Write-side HTTP boundary. Validates POST /values and atomically persists one value and Outbox message in ingestion_db."
      valuesEndpoint = component "HTTP ingestion endpoint" {
        description "Validates Idempotency-Key and decimal payload, then translates success, replay, validation errors and conflicts to HTTP."
      }
      ingestionUseCase = component "Idempotent ingestion use case" {
        description "Computes the request fingerprint, resolves replays and owns one value and its pending integration event."
      }
      ingestionPersistence = component "EF Core transactional persistence" {
        description "Persists a value and pending Outbox message atomically; PostgreSQL uniqueness resolves concurrent requests."
      }
    }

    ingestionOutboxWorker = container "Ingestion.Outbox.Worker" {
      #worker
      technology ".NET 10 Worker Service"
      description "Independently claims pending Outbox rows in ingestion_db and publishes persistent RabbitMQ events with broker confirmations."
      outboxPoller = component "Outbox poller" {
        description "Selects bounded batches using PostgreSQL FOR UPDATE SKIP LOCKED; marks published only after broker confirmation."
      }
      rabbitPublisher = component "RabbitMQ publisher adapter" {
        description "Declares durable topology and uses persistent mandatory publication with confirmations and stable event identity."
      }
    }

    consolidationApi = container "Consolidation.Api" {
      #api
      technology ".NET 10 / ASP.NET Core Minimal API"
      description "Read-side HTTP boundary. Reads only consolidation_db through the non-superuser consolidation_app role."
    }

    consolidationWorker = container "Consolidation.Worker" {
      #worker
      technology ".NET 10 Worker Service"
      description "Dedicated read-side background process. Uses consolidation_db through consolidation_app, declares RabbitMQ topology, and receives Redis only for the later duplicate-message fast path. Actual consumption/Inbox behavior comes later."
    }

    postgresql = container "PostgreSQL" {
      #database
      technology "PostgreSQL"
      description "One local PostgreSQL server hosting ingestion_db and consolidation_db with distinct non-superuser application roles and revoked public database access."
    }

    redis = container "Redis" {
      #cache
      technology "Redis"
      description "Disposable optimization resource for idempotency/deduplication fast paths. PostgreSQL remains authoritative."
    }

    rabbitmq = container "RabbitMQ" {
      #broker
      technology "RabbitMQ / AMQP 0-9-1"
      description "Aspire-managed broker with management UI and persistent storage. Both workers declare the durable direct lab.events.v1 exchange and durable consolidation.value-received.v1 queue bound by value.received.v1. The ingestion Outbox worker already polls and publishes confirmed events; the consolidation consumer/Inbox is planned for a later issue."
    }
  }

  aspire = softwareSystem "Aspire development environment" {
    #orchestration
    description "Local composition and developer-experience tooling. It is not part of the business message path."

    appHostDashboard = container ".NET Aspire AppHost / Dashboard" {
      #orchestration
      technology ".NET Aspire"
      description "Starts and observes local resources and provides the development dashboard."
    }
  }

  apiClient -> lab "Exercises the lab through HTTP"
  developer -> lab "Develops and studies the reference implementation"
  developer -> aspire.appHostDashboard "Runs and inspects the local environment"

  aspire.appHostDashboard -> lab.ingestionApi "Orchestrates local process"
  aspire.appHostDashboard -> lab.ingestionOutboxWorker "Orchestrates local process"
  aspire.appHostDashboard -> lab.consolidationApi "Orchestrates local process"
  aspire.appHostDashboard -> lab.consolidationWorker "Orchestrates local process"
  aspire.appHostDashboard -> lab.postgresql "Orchestrates local resource"
  aspire.appHostDashboard -> lab.redis "Orchestrates local resource"
  aspire.appHostDashboard -> lab.rabbitmq "Orchestrates local broker and its management UI"

  apiClient -> lab.ingestionApi "Submits values in the target write flow"
  apiClient -> lab.consolidationApi "Reads the consolidated result in the target read flow"

  lab.ingestionApi -> lab.postgresql "Uses ingestion_db as ingestion_app"
  lab.ingestionOutboxWorker -> lab.postgresql "Uses ingestion_db as ingestion_app"
  lab.consolidationApi -> lab.postgresql "Uses consolidation_db as consolidation_app"
  lab.consolidationWorker -> lab.postgresql "Uses consolidation_db as consolidation_app"

  lab.ingestionApi -> lab.redis "Receives Redis for HTTP idempotency fast path"
  lab.consolidationWorker -> lab.redis "Receives Redis for message deduplication fast path"

  lab.ingestionOutboxWorker -> lab.rabbitmq "Publishes persistent integration events with broker confirmations"
  lab.ingestionOutboxWorker.outboxPoller -> lab.postgresql "Claims pending Outbox records and commits confirmed publication"
  lab.ingestionOutboxWorker.outboxPoller -> lab.ingestionOutboxWorker.rabbitPublisher "Passes versioned event and stable message ID"
  lab.ingestionOutboxWorker.rabbitPublisher -> lab.rabbitmq "Mandatory persistent publish with broker confirmation"
  lab.consolidationWorker -> lab.rabbitmq "Declares durable exchange, queue and routing binding"
  lab.rabbitmq -> lab.consolidationWorker "Will deliver integration events once the Inbox consumer is implemented"
  apiClient -> lab.ingestionApi.valuesEndpoint "POST /values with Idempotency-Key"
  lab.ingestionApi.valuesEndpoint -> lab.ingestionApi.ingestionUseCase "Delegates the validated request"
  lab.ingestionApi.ingestionUseCase -> lab.ingestionApi.ingestionPersistence "Reads original receipt or commits value and Outbox"
  lab.ingestionApi.ingestionUseCase -> lab.redis "Optionally caches committed receipts"
  lab.ingestionApi.ingestionPersistence -> lab.postgresql "Uses ingestion_db and its unique key constraint"

}
