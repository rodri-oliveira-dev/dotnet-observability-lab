// C4 views for dotnet-observability-lab.

global {
  styleGroup architectureTheme {
    style element.tag = #api {
      notation "HTTP API"
      shape browser
      color indigo
    }

    style element.tag = #worker {
      notation "Worker / process without HTTP"
      shape component
      color amber
    }

    style element.tag = #database {
      notation "Persistent data store"
      shape cylinder
      color green
    }

    style element.tag = #cache {
      notation "Cache / optimization"
      shape cylinder
      color secondary
    }

    style element.tag = #broker {
      notation "Message broker"
      shape queue
      color red
    }

    style element.tag = #orchestration {
      notation "Development orchestration / dashboard"
      shape component
      color gray
    }

    style element.tag = #external {
      notation "External actor"
      color muted
    }

    style element.tag = #future {
      notation "Planned / not yet implemented"
      color muted
      border dotted
      opacity 70%
    }
  }
}

views {
  global style architectureTheme

  view systemContext {
    title "C4 Level 1 - System Context"
    description "Shows who interacts with dotnet-observability-lab and keeps .NET Aspire explicit as development tooling rather than part of the functional message path."
    include apiClient
    include developer
    include lab
    include aspire
    autoLayout LeftRight
  }

  view ingestionComponents of lab.ingestionApi {
    title "C4 Level 3 - Ingestion.Api"
    description "Shows the HTTP write boundary, idempotency, Redis optimization and the atomic PostgreSQL Outbox write."
    include apiClient
    include lab.ingestionApi.valuesEndpoint
    include lab.ingestionApi.ingestionUseCase
    include lab.ingestionApi.ingestionPersistence
    include lab.postgresql
    include lab.redis
    autoLayout LeftRight
  }

  view outboxPublisherComponents of lab.ingestionOutboxWorker {
    title "C4 Level 3 - Ingestion.Outbox.Worker"
    description "Dedicated PostgreSQL Outbox claiming and confirmed RabbitMQ publication, independent of Ingestion.Api."
    include lab.ingestionOutboxWorker.outboxPoller
    include lab.ingestionOutboxWorker.rabbitPublisher
    include lab.postgresql
    include lab.rabbitmq
    autoLayout LeftRight
  }

  view consolidationApiComponents of lab.consolidationApi {
    title "C4 Level 3 - Consolidation.Api"
    description "Independent HTTP read endpoint and read-only PostgreSQL query; no Ingestion.Api or RabbitMQ dependency."
    include apiClient
    include lab.consolidationApi.consolidatedEndpoint
    include lab.consolidationApi.consolidatedQuery
    include lab.postgresql
    autoLayout LeftRight
  }

  view consolidationComponents of lab.consolidationWorker {
    title "C4 Level 3 - Consolidation.Worker"
    description "Manual RabbitMQ acknowledgements after atomic PostgreSQL Inbox and read-model commit."
    include lab.rabbitmq
    include lab.consolidationWorker.rabbitConsumer
    include lab.consolidationWorker.inboxProcessor
    include lab.consolidationWorker.consolidationStore
    include lab.postgresql
    autoLayout LeftRight
  }

  view containers of lab {
    title "C4 Level 2 - Containers"
    description "Shows independent APIs, PostgreSQL, Redis and RabbitMQ business relationships; separate OTLP export edges end at the local Aspire Dashboard, which does not route business traffic."
    include apiClient
    include developer
    include lab.ingestionApi
    include lab.ingestionOutboxWorker
    include lab.consolidationApi
    include lab.consolidationWorker
    include lab.postgresql
    include lab.redis
    include lab.rabbitmq
    include aspire.appHostDashboard
    autoLayout LeftRight
  }
}
